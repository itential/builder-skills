{
  "_comment": "CHILD workflow pattern (Guide 4's try-catch pattern, generalized to N branches). Every single path that can reach workflow_end -- not just the 'main' success and error paths -- must funnel through a newVariable that sets taskStatus on $var.job.taskStatus BEFORE workflow_end. This is issue #3: if the child workflow grew a second success branch (e.g. an 'already configured / no-op, skip' path, or an alternate evaluation outcome) after the original build, and that branch was wired straight to workflow_end without going through the status-setting newVariable, that child's job variables never contain a taskStatus key at all. The child still finishes with status:'complete' and no errors -- but the parent's loop-array element for that iteration is missing taskStatus, which is exactly the intermittent 'null even though every child completed successfully' symptom, because it only affects the subset of devices that take that branch.",

  "tasks": {
    "workflow_start": { "name": "workflow_start", "groups": [], "nodeLocation": { "x": 600, "y": 100 } },

    "e1e1": {
      "name": "someAdapterOrConfigTask",
      "canvasName": "someAdapterOrConfigTask",
      "summary": "Do the actual work",
      "location": "Adapter",
      "locationType": "REPLACE_WITH_APPS_JSON_NAME",
      "app": "REPLACE_WITH_APPS_JSON_NAME",
      "type": "automatic",
      "displayName": "REPLACE_WITH_TASKS_JSON_displayName",
      "variables": {
        "incoming": { "adapter_id": "$var.job.adapter_id" },
        "outgoing": { "result": null },
        "error": "",
        "decorators": []
      },
      "groups": [],
      "actor": "Pronghorn",
      "scheduled": false,
      "nodeLocation": { "x": 600, "y": 208 }
    },

    "f2f2": {
      "name": "evaluation",
      "canvasName": "evaluation",
      "summary": "Already-configured / no-op check",
      "description": "Example of the SECOND branch that is easy to forget to wire into the try-catch pattern.",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "variables": {
        "incoming": {
          "all_true_flag": true,
          "evaluation_groups": [
            {
              "all_true_flag": true,
              "evaluations": [
                {
                  "operand_1": { "task": "e1e1", "variable": "result" },
                  "operator": "contains",
                  "operand_2": { "task": "static", "variable": "already exists" }
                }
              ]
            }
          ]
        },
        "outgoing": { "return_value": null },
        "error": "",
