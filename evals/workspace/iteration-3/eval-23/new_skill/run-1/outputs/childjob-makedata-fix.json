        "type": "operation",
        "displayName": "WorkFlowEngine",
        "variables": {
          "incoming": {
            "pass_on_null": false,
            "query": "loop",
            "obj": "$var.b2b2.merged_object"
          },
          "outgoing": { "return_data": "$var.job.subnetResults" }
        },
        "actor": "Pronghorn",
