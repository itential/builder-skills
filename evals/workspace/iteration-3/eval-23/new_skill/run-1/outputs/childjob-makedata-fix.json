        "displayName": "WorkFlowEngine",
        "variables": {
          "incoming": {
            "data_to_merge": [
              { "key": "title", "value": { "task": "static", "value": "Subnet Provisioning Report" } },
              { "key": "totalSubnets", "value": { "task": "d4d4", "variable": "return_data" } },
              { "key": "status", "value": { "task": "d5d5", "variable": "return_data" } }
            ]
          },
          "outgoing": { "merged_object": null }
        },
        "actor": "Pronghorn",
        "nodeLocation": { "x": 600, "y": 852 }
      },
      "f1f1": {
        "name": "makeData",
        "canvasName": "makeData",
        "summary": "Render final JSON string -- variables now points to a merge with NO childJob refs, so it compiles as a real taskRef and <!var!> placeholders resolve",
        "location": "Application",
        "locationType": null,
        "app": "WorkFlowEngine",
        "type": "automatic",
        "displayName": "Tools",
        "variables": {
          "incoming": {
            "input": "{\"title\": \"<!title!>\", \"totalSubnets\": <!totalSubnets!>, \"status\": \"<!status!>\"}",
            "outputType": "json",
            "variables": "$var.e5e5.merged_object"
          },
          "outgoing": { "output": "$var.job.finalReport" }
        },
        "actor": "Pronghorn",
        "nodeLocation": { "x": 600, "y": 960 }
      },
      "errh1": {
        "name": "newVariable",
        "canvasName": "newVariable",
        "summary": "Shared error handler",
        "location": "Application",
        "locationType": null,
        "app": "WorkFlowEngine",
        "type": "operation",
        "displayName": "WorkFlowEngine",
        "variables": {
          "incoming": { "name": "taskStatus", "value": "error" },
          "outgoing": { "value": "$var.job.taskStatus" }
        },
        "actor": "Pronghorn",
        "nodeLocation": { "x": 936, "y": 636 }
      }
    },
    "transitions": {
      "workflow_start": { "a1a1": { "type": "standard", "state": "success" } },
      "a1a1": {
