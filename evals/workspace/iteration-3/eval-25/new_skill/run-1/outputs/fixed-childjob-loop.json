{
  "_comment": "FIX — forEach enrichment pattern (Builder Agent SKILL.md, Guide 4 / Mode B). Enriches each loop-array element with the shared job-level fields (subscription_id, region) BEFORE the childJob loop runs, so every element satisfies the child workflow's inputSchema.required on its own.",

  "_flow": "workflow_start -> e0a0 (newVariable: init accumulator) -> e1a1 (forEach over $var.job.subnets) --loop--> e2a2 (merge: current_item + subscription_id + region) -> e3a3 (arrayPush: append to enrichedSubnets) --(end of body, empty transition, forEach picks up next item)--   e1a1 --success (loop finished)--> e4a4 (childJob: data_array = enrichedSubnets, variables = {}) -> e5a5 (query: extract per-iteration statuses) -> workflow_end. childJob error path -> ef01 (newVariable error flag) -> workflow_end.",

  "tasks": {
    "workflow_start": {
      "name": "workflow_start",
      "groups": [],
      "nodeLocation": {"x": 600, "y": 200}
    },

    "e0a0": {
      "name": "newVariable",
      "canvasName": "newVariable",
      "summary": "Initialize Enriched Subnets Accumulator",
      "description": "Initializes the array that will hold each subnet element after shared fields are merged in",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "variables": {
        "incoming": {
          "name": "enrichedSubnets",
          "value": []
        },
        "outgoing": {"value": ""},
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "groups": [],
      "scheduled": false,
      "nodeLocation": {"x": 600, "y": 308}
    },

    "e1a1": {
      "name": "forEach",
      "canvasName": "forEach",
      "summary": "Iterate Over Each Subnet",
      "description": "Loops over the raw subnets array (subnet_name/subnet_cidr only) so each element can be enriched with shared fields before the childJob loop",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "variables": {
        "incoming": {
          "data_array": "$var.job.subnets"
        },
        "outgoing": {"current_item": null},
        "error": "",
        "decorators": []
      },
      "groups": [],
      "scheduled": false,
      "nodeLocation": {"x": 600, "y": 416}
    },

    "e2a2": {
      "name": "merge",
      "canvasName": "merge",
      "summary": "Merge Shared Fields Into Current Subnet",
      "description": "Combines the current forEach element with the shared subscription_id and region job variables",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "variables": {
        "incoming": {
          "data_to_merge": [
            {"task": "e1a1", "variable": "current_item"},
            {"key": "subscription_id", "value": {"task": "job", "variable": "subscription_id"}},
            {"key": "region", "value": {"task": "job", "variable": "region"}}
          ]
        },
        "outgoing": {"merged_object": null},
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "groups": [],
      "nodeLocation": {"x": 600, "y": 524}
    },

    "e3a3": {
      "name": "arrayPush",
      "canvasName": "push",
      "summary": "Append Enriched Subnet To Accumulator",
      "description": "Pushes the merged (per-iteration + shared) object onto the enrichedSubnets job variable",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "variables": {
        "incoming": {
          "job_variable": "enrichedSubnets",
          "item_to_push": "$var.e2a2.merged_object"
        },
        "outgoing": {},
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "groups": [],
      "nodeLocation": {"x": 600, "y": 632}
    },

    "e4a4": {
      "name": "childJob",
      "canvasName": "childJob",
      "summary": "Provision Subnets (parallel, per-subnet)",
      "description": "Runs the child workflow once per enriched subnet element. variables is empty because every required child input (per-iteration AND shared) is now present in each data_array element.",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "variables": {
        "incoming": {
          "task": "",
          "workflow": "Create Subnet - Child",
          "variables": {},
          "data_array": "$var.job.enrichedSubnets",
          "transformation": "",
          "loopType": "parallel"
        },
        "outgoing": {"job_details": null}
      },
      "actor": "job",
      "groups": [],
      "nodeLocation": {"x": 600, "y": 740}
    },

    "e5a5": {
      "name": "query",
      "canvasName": "query",
      "summary": "Extract Per-Subnet Results",
      "description": "Pulls the loop results array out of job_details",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "variables": {
        "incoming": {
          "pass_on_null": false,
          "query": "loop",
          "obj": "$var.e4a4.job_details"
        },
        "outgoing": {"return_data": "$var.job.subnetResults"},
        "error": "",
        "decorators": []
      },
      "groups": [],
      "scheduled": false,
      "nodeLocation": {"x": 600, "y": 848}
    },

    "ef01": {
      "name": "newVariable",
      "canvasName": "newVariable",
      "summary": "Flag Subnet Provisioning Error",
      "description": "Error handler so both success and error can each reach workflow_end without duplicate transition keys",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "variables": {
        "incoming": {
          "name": "subnetProvisioningStatus",
          "value": "error"
        },
        "outgoing": {"value": ""},
        "error": "",
        "decorators": []
      },
      "actor": "Pronghorn",
      "groups": [],
      "nodeLocation": {"x": 864, "y": 740}
    },

    "workflow_end": {
      "name": "workflow_end",
      "groups": [],
      "nodeLocation": {"x": 600, "y": 956}
    }
  },

  "transitions": {
    "workflow_start": {
      "e0a0": {"type": "standard", "state": "success"}
    },
    "e0a0": {
      "e1a1": {"type": "standard", "state": "success"}
    },
    "e1a1": {
      "e2a2": {"type": "standard", "state": "loop"},
      "e4a4": {"type": "standard", "state": "success"}
    },
    "e2a2": {
      "e3a3": {"type": "standard", "state": "success"}
    },
    "e3a3": {},
    "e4a4": {
      "e5a5": {"type": "standard", "state": "success"},
      "ef01": {"type": "standard", "state": "error"}
    },
    "e5a5": {
      "workflow_end": {"type": "standard", "state": "success"}
    },
    "ef01": {
      "workflow_end": {"type": "standard", "state": "success"}
    },
    "workflow_end": {}
  },

  "inputSchema_note": "Parent inputSchema should list: subnets (array, required), subscription_id (string, required), region (string, required). Child workflow's inputSchema.required must be exactly: subnet_name, subnet_cidr, subscription_id, region — all four now present on every element of $var.job.enrichedSubnets."
}
