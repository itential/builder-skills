{
  "_comment": "Fragment of the LCM Create action workflow showing where the fixed instance-write merge task sits, plus the inputSchema/outputSchema shape confirmed against a real LCM asset (helpers/assets/lcm/lcm-vxlan-fabric-management.json, actions[1].outputSchema): every LCM action workflow must produce a job variable named 'instance' as a required output, and that object is what the platform writes back to the resource instance record. If 'instance' does not contain every property listed in the resource model's schema.required, the instance write fails schema validation.",
  "tasks": {
    "workflow_start": {
      "name": "workflow_start",
      "groups": [],
      "nodeLocation": {"x": 600, "y": 200}
    },
    "e1a1": {
      "name": "merge",
      "canvasName": "merge",
      "summary": "Build Resource Instance Data",
      "description": "Builds the object that becomes the LCM resource instance — must satisfy the model's schema.required list",
      "location": "Application",
      "locationType": null,
      "app": "WorkFlowEngine",
      "type": "operation",
      "displayName": "WorkFlowEngine",
      "variables": {
        "incoming": {
          "data_to_merge": [
            {"key": "subscription_id", "value": {"task": "job", "variable": "subscription_id"}},
            {"key": "resource_group",  "value": {"task": "job", "variable": "resource_group"}},
            {"key": "vnet_name",       "value": {"task": "job", "variable": "vnet_name"}},
            {"key": "vlan_id",         "value": {"task": "job", "variable": "vlan_id"}}
          ]
        },
        "outgoing": {
          "merged_object": "$var.job.instance"
        },
        "error": "",
        "decorators": []
      },
      "groups": [],
      "actor": "Pronghorn",
      "scheduled": false,
      "nodeLocation": {"x": 600, "y": 312}
    },
    "workflow_end": {
      "name": "workflow_end",
      "groups": [],
      "nodeLocation": {"x": 600, "y": 420}
    }
  },
  "transitions": {
    "workflow_start": {
      "e1a1": {"type": "standard", "state": "success"}
    },
    "e1a1": {
      "workflow_end": {"type": "standard", "state": "success"}
    },
    "workflow_end": {}
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "subscription_id": {"title": "subscription_id", "type": "string"},
      "resource_group": {"title": "resource_group", "type": "string"},
      "vnet_name": {"title": "vnet_name", "type": "string"},
      "vlan_id": {"title": "vlan_id", "type": "integer"}
    },
    "required": ["subscription_id", "resource_group", "vnet_name", "vlan_id"]
  },
  "outputSchema": {
    "type": "object",
    "required": ["instance"],
    "properties": {
      "instance": {
        "description": "Must satisfy the resource model's schema.required list",
        "type": "object",
        "required": ["subscription_id", "resource_group", "vnet_name", "vlan_id"],
        "additionalProperties": true,
        "properties": {
          "subscription_id": {"type": "string"},
          "resource_group": {"type": "string"},
          "vnet_name": {"type": "string"},
          "vlan_id": {"type": "integer"}
        }
      }
    }
  }
}
