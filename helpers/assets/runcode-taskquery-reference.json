          "3c0b": {
            "name": "runCode",
            "canvasName": "runCode",
            "summary": "Execute code on a gateway",
            "description": "Execute code (e.g. Python) on a Gateway5 cluster without requiring a pre-configured service. The code is sent directly to the gateway for execution.",
            "location": "Application",
            "locationType": null,
            "app": "GatewayManager",
            "type": "automatic",
            "displayName": "GatewayManager",
            "variables": {
              "incoming": {
                "clusterId": "cluster-itential",
                "language": "python",
                "code": "import sys, json\ndata = json.load(sys.stdin)\ndef extract_results(value):\n    \"\"\"Accept either the raw NetBox paginated wrapper ({count, results: [...]})\n    or an already-queried plain array (if inline query extracts .results upstream).\"\"\"\n    if isinstance(value, dict) and 'results' in value:\n        return value['results']\n    if isinstance(value, list):\n        return value\n    return []\n\ndevices = extract_results(data.get('devicelist'))\ninterfaces = extract_results(data.get('interfacelist'))\n\n# Group interfaces under their parent device. Real NetBox interfaces reference the device\n# via interface['device']['id']; fall back to matching interface['id'] directly if that\n# shape isn't present (matches the sample data given, which mirrors the device shape).\ninterfaces_by_device = {}\nfor iface in interfaces:\n    device_ref = iface.get('device') or {}\n    device_id = device_ref.get('id', iface.get('id'))\n    interfaces_by_device.setdefault(device_id, []).append(iface)\n\ncombined = []\nfor device in devices:\n    device_type = device.get('device_type') or {}\n    manufacturer = device_type.get('manufacturer') or {}\n    device_id = device.get('id')\n    device_interfaces = interfaces_by_device.get(device_id, [])\n\n    combined.append({\n        'id': device_id,\n        'name': device.get('name'),\n        'display': device.get('display'),\n        'manufacturer': manufacturer.get('name'),\n        'model': device_type.get('model'),\n        'interface_count': len(device_interfaces),\n        'interfaces': [i.get('name') for i in device_interfaces if i.get('name')],\n    })\n\nprint(json.dumps({\n    'device_count': len(devices),\n    'devices': combined,\n}))                                                                                                                                                             ",
                "data": {
                  "devicelist": "$var.8850.response#/body",
                  "interfacelist": "$var.4e04.response#/body"
                },
                "safety": {
                  "timeout": 30
                },
                "packages": []
              },
              "outgoing": {
                "result": ""
              },
              "decorators": [
                {
                  "type": "query",
                  "pointer": "/incoming/data/devicelist",
                  "displayPath": ".body"
                },
                {
                  "type": "query",
                  "pointer": "/incoming/data/interfacelist",
                  "displayPath": ".body"
                }
              ]
            },
            "actor": "Pronghorn",
            "groups": [],
            "nodeLocation": {
              "x": 0,
              "y": -132
            }
          },
